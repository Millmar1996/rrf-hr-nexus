# Supabase project settings (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Temporary compatibility for an existing legacy anon key. Prefer a publishable key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only add a service role key to a server-only deployment environment if a
# specific privileged server operation requires it. Never expose it to client code.
# SUPABASE_SERVICE_ROLE_KEY=

# Single HR administrator credentials. Keep these server-side only.
HR_ADMIN_USERNAME=
HR_ADMIN_PASSWORD=
